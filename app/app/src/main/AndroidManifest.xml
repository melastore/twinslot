<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The job notification, and the wake lock that keeps an install going with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Fingerprint unlock of the app lock. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Root managers, so the no-root screen can name the one installed and open it. -->
    <queries>
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="io.github.vvb2060.magisk" />
        <package android:name="io.github.huskydg.magisk" />
        <package android:name="me.weishu.kernelsu" />
        <package android:name="com.rifsxd.ksunext" />
        <package android:name="com.sukisu.ultra" />
        <package android:name="com.kowx712.supermanager" />
        <package android:name="me.bmax.apatch" />
    </queries>

    <application
        android:name=".TwinSlotApp"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.TwinSlot">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Settings" />

        <activity
            android:name=".GuideActivity"
            android:exported="false"
            android:label="Guide" />

        <activity
            android:name=".DiagnosticsActivity"
            android:exported="false"
            android:label="Diagnostic log" />

        <!-- Serves the diagnostic log file to the app it is shared with, nothing else. -->
        <provider
            android:name=".LogProvider"
            android:authorities="com.melastore.twinslot.logs"
            android:exported="false"
            android:grantUriPermissions="true" />

        <activity
            android:name=".ZipActivity"
            android:exported="false"
            android:label="Recovery zip" />

        <service
            android:name=".JobService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".SwitchTile"
            android:exported="true"
            android:icon="@drawable/ic_twinslot"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
